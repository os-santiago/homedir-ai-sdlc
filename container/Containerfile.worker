# ============================================================================
# HomeDir AI SDLC Worker - Podman/OCI Container Image
# ============================================================================
#
# Autonomous software factory worker that implements GitHub issues
# using AI-driven development with policy-based decision making.
#
# Build:  podman build -f container/Containerfile.worker -t homedir-ai-sdlc:latest .
# Run:    podman run --rm homedir-ai-sdlc:latest
#
# ============================================================================

FROM docker.io/library/ubuntu:24.04

LABEL maintainer="scanales-stack"
LABEL org.opencontainers.image.source="https://github.com/os-santiago/homedir-ai-sdlc"
LABEL org.opencontainers.image.description="AI-SDLC Worker - Autonomous software factory"
LABEL org.opencontainers.image.licenses="MIT"

# ============================================================================
# System Dependencies
# ============================================================================
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    # Core tools
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    python3 \
    python3-pip \
    # Build tools (for potential compilation in SCC)
    build-essential \
    # Cleanup
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# ============================================================================
# GitHub CLI
# ============================================================================
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | \
    dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | \
    tee /etc/apt/sources.list.d/github-cli.list > /dev/null && \
    apt-get update && \
    apt-get install -y gh && \
    rm -rf /var/lib/apt/lists/*

# Configure gh to use environment token authentication
# This allows GH_TOKEN to work without explicit gh auth login
RUN mkdir -p /etc/skel/.config/gh && \
    echo 'git_protocol: https' > /etc/skel/.config/gh/config.yml && \
    echo 'prompt: disabled' >> /etc/skel/.config/gh/config.yml && \
    chmod -R 755 /etc/skel/.config

# ============================================================================
# Claude Code CLI (SCC binary)
# ============================================================================
# Install Claude Code CLI from releases
ARG CLAUDE_VERSION=2.1.233
RUN ARCH=$(uname -m | sed 's/x86_64/x64/;s/aarch64/arm64/') && \
    echo "Downloading Claude Code CLI ${CLAUDE_VERSION} for ${ARCH}..." && \
    curl -fsSL "https://github.com/anthropics/claude-code/releases/download/v${CLAUDE_VERSION}/claude-linux-${ARCH}.tar.gz" \
    -o /tmp/claude.tar.gz && \
    tar -xzf /tmp/claude.tar.gz -C /usr/local/bin/ && \
    rm /tmp/claude.tar.gz && \
    chmod +x /usr/local/bin/claude && \
    # Create scc symlink for backward compatibility with existing scripts
    ln -s /usr/local/bin/claude /usr/local/bin/scc && \
    claude --version || \
    (echo "ERROR: Claude Code CLI installation failed" && exit 1)

# ============================================================================
# Rootless Compatibility
# ============================================================================
# IMPORTANT: Do NOT create specific user or use USER directive
# Container must run with --user $(id -u):$(id -g) at runtime
# Create state directories with world-writable permissions for any UID
RUN mkdir -p /var/lib/homedir-sdlc /srv/homedir-sdlc/worktrees /var/log/homedir-sdlc && \
    chmod -R 777 /var/lib/homedir-sdlc /srv/homedir-sdlc /var/log/homedir-sdlc

# ============================================================================
# Platform Code
# ============================================================================
WORKDIR /app

# Copy platform scripts and configs
COPY platform/ /app/

# Make scripts executable
RUN chmod +x /app/scripts/*.sh

# ============================================================================
# Container Entrypoint
# ============================================================================
COPY container/worker-entrypoint.sh /app/
RUN chmod +x /app/worker-entrypoint.sh

# Make /app readable/executable by any UID (rootless compatibility)
RUN chmod -R 755 /app

# ============================================================================
# Runtime Configuration
# ============================================================================
# NO USER directive - container will run with --user at runtime
# This allows dynamic UID matching for CI/CD environments

# Environment defaults (override at runtime)
ENV PLATFORM_DIR=/app
ENV HOMEDIR_SDLC_STATE_DIR=/var/lib/homedir-sdlc
ENV HOMEDIR_SDLC_WORKDIR=/srv/homedir-sdlc/worktrees/homedir
ENV HOMEDIR_SDLC_LOGFILE=/var/log/homedir-sdlc/worker.log
ENV HOMEDIR_SDLC_REPO=os-santiago/homedir
ENV SCC_BIN=/usr/local/bin/scc

# Volumes (mount points)
VOLUME ["/var/lib/homedir-sdlc", "/srv/homedir-sdlc/worktrees", "/var/log/homedir-sdlc"]

# Healthcheck
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD test -f /var/lib/homedir-sdlc/heartbeat.json && \
        python3 -c "import json,sys,time; \
        h=json.load(open('/var/lib/homedir-sdlc/heartbeat.json')); \
        sys.exit(0 if h.get('status') in ['ok','idle','running','starting'] else 1)"

# Entrypoint
ENTRYPOINT ["/app/worker-entrypoint.sh"]
CMD ["reconcile"]
