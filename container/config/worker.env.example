# ============================================================================
# AI-SDLC Worker Environment Configuration
# ============================================================================
#
# This file must be deployed to /etc/homedir-sdlc/worker.env on the VPS
# The worker container loads these variables via --env-file
#
# SECURITY: Never commit actual values to git - this is a template only
# ============================================================================

# GitHub Authentication
# Required for creating PRs, pushing branches, and API operations
GH_TOKEN=ghp_YOUR_GITHUB_TOKEN_HERE

# NVIDIA API Configuration
# Required for sc-agent-cli to use Nemotron model
# Get your key from: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=nvapi_YOUR_NVIDIA_API_KEY_HERE

# Repository Configuration
HOMEDIR_SDLC_REPO=os-santiago/homedir

# Worker Configuration
HOMEDIR_SDLC_STATE_DIR=/var/lib/homedir-sdlc
HOMEDIR_SDLC_WORKDIR=/srv/homedir-sdlc/worktrees/homedir
PLATFORM_DIR=/app
HOMEDIR_SDLC_LOGFILE=/var/log/homedir-sdlc/worker.log

# Git Configuration
HOMEDIR_SDLC_GIT_USER_NAME=homedir-sdlc[bot]
HOMEDIR_SDLC_GIT_USER_EMAIL=homedir-sdlc@users.noreply.github.com

# SCC Configuration
SCC_BIN=scc
SCC_TIMEOUT_SECONDS=600
SCC_CLEAR_HISTORY=true

# Optional: Worker Interval (seconds between reconcile cycles)
HOMEDIR_SDLC_INTERVAL=180

# Optional: Worker Version (for heartbeat tracking)
HOMEDIR_SDLC_WORKER_VERSION=1.0.0
