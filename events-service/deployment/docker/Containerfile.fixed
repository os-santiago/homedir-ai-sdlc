# SOLUCIÓN FINAL - Contenedor production con nginx reverse proxy
# Resuelve el issue de Quarkus dev mode en HTTP responses

# Stage 1: Build application
FROM docker.io/library/maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml ./
COPY .mvn .mvn
RUN mvn dependency:go-offline -B || true
COPY src ./src
RUN mvn clean package -DskipTests -Dquarkus.package.type=fast-jar -B

# Stage 2: Runtime con nginx proxy
FROM docker.io/library/eclipse-temurin:21-jre-alpine

# Instalar nginx y supervisord
RUN apk add --no-cache nginx supervisor curl

# Copiar aplicación Quarkus
WORKDIR /app
COPY --from=build /build/target/quarkus-app/lib/ ./lib/
COPY --from=build /build/target/quarkus-app/*.jar ./
COPY --from=build /build/target/quarkus-app/app/ ./app/
COPY --from=build /build/target/quarkus-app/quarkus/ ./quarkus/

# Configurar nginx como reverse proxy limpio
RUN mkdir -p /run/nginx && \
    cat > /etc/nginx/http.d/default.conf <<'EOF'
server {
    listen 8080;

    # Proxy a Quarkus (puerto interno 8081)
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Si hay error 500, devolver JSON genérico
        proxy_intercept_errors off;
    }
}
EOF

# Configurar supervisord para correr ambos servicios
# Usa variables de entorno para HTTP_HOST y HTTP_PORT
RUN cat > /etc/supervisord.conf <<'EOF'
[supervisord]
nodaemon=true
user=root

[program:quarkus]
command=java -Dquarkus.profile=prod -jar /app/quarkus-run.jar
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:nginx]
command=nginx -g 'daemon off;'
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
EOF

EXPOSE 8080

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
