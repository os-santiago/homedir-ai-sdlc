[Unit]
Description=HomeDir autonomous SDLC SCC worker (user)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/homedir-sdlc/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/homedir-sdlc-worker.sh
StandardOutput=append:/var/lib/homedir-sdlc/logs/worker.log
StandardError=append:/var/lib/homedir-sdlc/logs/worker.log
Nice=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
