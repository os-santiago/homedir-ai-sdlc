{
  "model": {
    "provider": "openai-compatible",
    "baseUrl": "https://integrate.api.nvidia.com/v1",
    "model": "meta/llama-3.1-8b-instruct",
    "temperature": 0.7,
    "maxTokens": 4096,
    "stream": true,
    "timeout": 120000
  },
  "permissions": {
    "autoApprove": [
      "read_file",
      "list_dir",
      "search_text",
      "web_fetch",
      "memory_read",
      "run_shell",
      "write_file",
      "edit_file"
    ],
    "denyPaths": [
      ".env",
      ".env.*",
      "**/*.key",
      "**/*.pem"
    ]
  },
  "profiles": {
    "nvidia": {
      "provider": "openai-compatible",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "model": "meta/llama-3.1-8b-instruct",
      "temperature": 0.7,
      "maxTokens": 4096,
      "timeout": 120000
    },
    "nvidia-fast": {
      "provider": "openai-compatible",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "model": "meta/llama-3.3-70b-instruct",
      "temperature": 0.3,
      "maxTokens": 2048,
      "timeout": 60000
    },
    "ollama": {
      "baseUrl": "http://localhost:11434/v1",
      "model": "llama3.2"
    }
  },
  "activeProfile": "nvidia"
}
