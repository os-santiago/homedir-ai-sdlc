{
  "model": {
    "provider": "openai",
    "baseUrl": "https://api.openai.com/v1",
    "model": "gpt-4o-mini",
    "temperature": 0.7,
    "maxTokens": 4096,
    "stream": true,
    "timeout": 120000
  },
  "permissions": {
    "autoApprove": [
      "read_file",
      "list_dir",
      "search_text",
      "web_fetch",
      "memory_read",
      "run_shell",
      "write_file",
      "edit_file"
    ],
    "denyPaths": [
      ".env",
      ".env.*",
      "**/*.key",
      "**/*.pem"
    ]
  },
  "profiles": {
    "openai": {
      "provider": "openai",
      "baseUrl": "https://api.openai.com/v1",
      "model": "gpt-4o-mini",
      "temperature": 0.7,
      "maxTokens": 4096,
      "timeout": 120000
    },
    "openai-fast": {
      "provider": "openai",
      "baseUrl": "https://api.openai.com/v1",
      "model": "gpt-3.5-turbo",
      "temperature": 0.3,
      "maxTokens": 2048,
      "timeout": 60000
    }
  },
  "activeProfile": "openai"
}
